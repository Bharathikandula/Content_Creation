# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/fashion_creator
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/fashion_creator

# Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL_STRONG=gemini-3.5-flash
GEMINI_MODEL_CHEAP=gemini-3.5-flash-lite

# SerpAPI
SERPAPI_API_KEY=your-serpapi-key

# Cuelinks
CUELINKS_API_KEY=your-cuelinks-key
CUELINKS_SUBID=fashion_creator

# S3 Storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=fashion-creator-photos
S3_REGION=us-east-1

# Photo expiry
PHOTO_EXPIRY_HOURS=24

# JWT
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080